<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
<key>CFBundleIdentifier</key><string>ru.kadrolov.desktop</string>
<key>CFBundleName</key><string>Кадролов</string>
<key>CFBundleDisplayName</key><string>Кадролов</string>
<key>CFBundleIconFile</key><string>kadrolov.icns</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
<key>CFBundleVersion</key><string>2</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSScreenCaptureUsageDescription</key><string>Кадролов делает снимки и записывает выбранный экран по вашей команде.</string>
<key>NSMicrophoneUsageDescription</key><string>Микрофон записывается только если вы включили его перед записью.</string>
<key>NSCameraUsageDescription</key><string>Камера добавляется в запись только по вашему выбору.</string>
</dict></plist>
